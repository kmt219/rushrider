VITE_GOLDRUSH_API_KEY=your_api_key_here
# Staging endpoint required for gems subscriptions (production endpoint coming soon)
VITE_GOLDRUSH_STREAM_URL=wss://streaming.goldrushdata.com/graphql
VITE_GOLDRUSH_API_URL=https://api.goldrush.dev/graphql
# Optional: override the chain name (defaults to MEGAETH_MAINNET)
# VITE_CHAIN_NAME=BASE_MAINNET
# USDM token contract address on MegaETH mainnet (used by useUSDMSupply hook)
VITE_USDM_ADDRESS=0xFAfDdbb3FC7688494971a79cc65DCa3EF82079E7

# --- Server-side gems cache (optional but strongly recommended) ---
# Powers the /api/gems-cache endpoint so GAINERS/LOSERS/SPIKES/MOMENTUM tabs
# are populated instantly on the very first dashboard load for every user.
# Provisioned automatically when you add a Vercel KV store to your project
# (Dashboard → Storage → Create KV), or set manually for Upstash Redis:
#   https://upstash.com → create a Redis database → REST API tab
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your_upstash_token

# ── LP Analyzer (Uniswap V3 on Base, powered by GoldRush Pipeline API) ────────
# Neon Postgres connection string — tables populated by GoldRush Pipeline.
# Get from: https://neon.tech → your project → Connection Details → Connection string
# Format: postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL=

# Optional: Base mainnet JSON-RPC URL for fetching uncollected fees via NPM contract.
# Defaults to https://mainnet.base.org (public, no auth required).
# BASE_RPC_URL=https://mainnet.base.org

# Set to "true" to use mock fixture data for frontend dev (no real Neon DB needed)
# VITE_LP_MOCK=true
#
# LP Analyzer requires Vercel CLI for local Edge Function dev:
#   pnpm add -g vercel && vercel dev    (instead of pnpm dev)
#   See apps/dexworks/api/lp/README.md for full setup guide
