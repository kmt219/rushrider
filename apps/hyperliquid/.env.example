# ── GoldRush Streaming (required for live data) ──────────────────────────────
# Get a free API key at https://goldrush.dev/platform/apikey
VITE_GOLDRUSH_API_KEY=your_api_key_here

# WebSocket endpoint (defaults to wss://streaming.goldrushdata.com/graphql)
VITE_GOLDRUSH_STREAM_URL=wss://streaming.goldrushdata.com/graphql

# GoldRush Hyperliquid Info API host (defaults to https://hypercore.goldrushdata.com/info).
# Drop-in replacement for the public /info API; authenticated with VITE_GOLDRUSH_API_KEY.
# Only metaAndAssetCtxs / spotMetaAndAssetCtxs / outcomeMeta are routed here today.
VITE_GOLDRUSH_INFO_URL=https://hypercore.goldrushdata.com/info

# Chain to stream from (defaults to HYPERCORE_MAINNET — Hyperliquid HyperCore L1)
VITE_GOLDRUSH_CHAIN_NAME=HYPERCORE_MAINNET

# ── Node stream override (optional, takes priority over GoldRush) ─────────────
# Self-hosted Hyperliquid node WebSocket — raw protobuf block stream.
# When set, all hooks read from the node stream instead of GoldRush.
# Example: ws://your-node-host:8080/stream
VITE_HL_NODE_WS_URL=
